<?xml version="1.0" encoding="UTF-8"?>
<!-- 后端构建：Java21、SpringBoot、MySQL；测试使用独立H2配置，不更改正式数据库。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>cn.campus</groupId><artifactId>study-room</artifactId><version>0.3.0</version><name>校园自习室预约</name>
  <properties>
    <java.version>21</java.version>
    <!-- 普通构建H2仅用于测试；演示配置不进入生产jar。显式-Pdemo才改变两项。 -->
    <app.h2.scope>test</app.h2.scope>
    <app.demo.exclude>application-demo.yml</app.demo.exclude>
  </properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-crypto</artifactId></dependency>
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>${app.h2.scope}</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <!-- 排除内存演示和测试配置；prod与通用MySQL配置正常入包，Flyway迁移不得过滤。 -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>${app.demo.exclude}</exclude>
          <exclude>application-test.yml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins>
  </build>
  <profiles>
    <!-- 可选本地合成演示包：与普通生产包二选一，切换必须clean以免残留配置。 -->
    <profile>
      <id>demo</id>
      <properties>
        <app.h2.scope>runtime</app.h2.scope>
        <app.demo.exclude>__no_demo_config_exclusion__</app.demo.exclude>
      </properties>
    </profile>
  </profiles>
</project>
